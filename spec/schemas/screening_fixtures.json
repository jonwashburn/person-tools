{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screening_fixtures.json",
  "title": "The published screening fixtures (SCREEN-7), shape only",
  "type": "object",
  "required": [
    "version",
    "forbidden",
    "allowed"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "about": {
      "type": "string"
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "category",
          "kind",
          "ask"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "common.json#/$defs/screening_category"
          },
          "kind": {
            "$ref": "common.json#/$defs/kind"
          },
          "ask": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "content": {
            "$ref": "common.json#/$defs/content"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ask"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "common.json#/$defs/kind"
          },
          "ask": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "content": {
            "$ref": "common.json#/$defs/content"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
