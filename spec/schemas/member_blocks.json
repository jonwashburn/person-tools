{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "member_blocks.json",
  "title": "The person's blocks: GET /v1/member/blocks (section 26.8)",
  "type": "object",
  "required": [
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "name",
          "since"
        ],
        "additionalProperties": false,
        "properties": {
          "block_id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "since": {
            "$ref": "common.json#/$defs/time"
          }
        }
      }
    }
  }
}
