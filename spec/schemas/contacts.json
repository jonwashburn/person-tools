{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contacts.json",
  "title": "Someone else's contact details on an ask (section 27.7)",
  "type": "array",
  "minItems": 1,
  "maxItems": 4,
  "items": {
    "type": "object",
    "required": [
      "id",
      "role",
      "consent"
    ],
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "name"
        ]
      },
      {
        "required": [
          "phone"
        ]
      },
      {
        "required": [
          "email"
        ]
      }
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^c[1-4]$"
      },
      "role": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30,
        "pattern": "^[A-Za-z][A-Za-z ]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "phone": {
        "type": "string",
        "pattern": "^\\+[1-9][0-9]{7,14}$"
      },
      "email": {
        "type": "string",
        "maxLength": 254,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "consent": {
        "enum": [
          "they_contacted_the_asker",
          "they_agreed_to_be_contacted"
        ]
      }
    }
  },
  "description": "ref never reaches the person's client; a role that reads as a name is refused by the server (ASKS-17)."
}
