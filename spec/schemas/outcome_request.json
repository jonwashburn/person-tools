{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_request.json",
  "title": "POST /v1/calls/{call_id}/outcome body",
  "type": "object",
  "required": [
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^[^\\r\\n]*$"
    },
    "idempotency_key": {
      "$ref": "common.json#/$defs/idempotency_key"
    }
  }
}
