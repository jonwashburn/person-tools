{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "member_people_link.json",
  "title": "A join link, shown once (section 26.10)",
  "type": "object",
  "required": [
    "label",
    "join_url"
  ],
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "join_url": {
      "$ref": "common.json#/$defs/https_url"
    },
    "for_them": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    }
  }
}
