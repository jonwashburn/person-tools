{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "member_sent_read_request.json",
  "title": "Mark threads read on every device: POST /v1/member/sent/read (section 26.10)",
  "type": "object",
  "required": [
    "task_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "task_ids": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/id"
      },
      "minItems": 1,
      "maxItems": 80
    }
  }
}
