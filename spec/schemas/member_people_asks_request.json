{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "member_people_asks_request.json",
  "title": "Send an ask to one's own people: POST /v1/member/people/asks (section 26.10)",
  "type": "object",
  "required": [
    "to",
    "title",
    "step"
  ],
  "additionalProperties": false,
  "properties": {
    "to": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "step": {
      "$ref": "member_task.json#/$defs/step"
    },
    "unlocks": {
      "type": "string",
      "minLength": 0,
      "maxLength": 300
    },
    "urgency": {
      "enum": [
        "now",
        "today",
        "whenever"
      ]
    },
    "expires_in": {
      "type": "integer",
      "minimum": 60
    },
    "card": {
      "$ref": "member_task.json#/properties/card"
    }
  }
}
