{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jwks.json",
  "title": "The JSON Web Key Set at jwks_uri (sections 5 and 21)",
  "type": "object",
  "required": [
    "keys"
  ],
  "additionalProperties": false,
  "properties": {
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kty",
          "crv",
          "x",
          "kid"
        ],
        "properties": {
          "kty": {
            "const": "OKP"
          },
          "crv": {
            "const": "Ed25519"
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "kid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "alg": {
            "const": "EdDSA"
          },
          "use": {
            "const": "sig"
          }
        },
        "not": {
          "required": [
            "d"
          ]
        },
        "description": "Ed25519 public keys (RFC 8037). Other JWK members (RFC 7517) may appear; the private part d never does."
      }
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kty",
          "crv",
          "x",
          "kid",
          "revoked_at"
        ],
        "properties": {
          "kty": {
            "const": "OKP"
          },
          "crv": {
            "const": "Ed25519"
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "kid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "alg": {
            "const": "EdDSA"
          },
          "use": {
            "const": "sig"
          },
          "revoked_at": {
            "$ref": "common.json#/$defs/time"
          }
        },
        "not": {
          "required": [
            "d"
          ]
        }
      },
      "description": "Revoked keys, kept with their public part and revoked_at: a receipt that checks only against one proves nothing about when it was signed; the server re-signs its receipts under a current key (RCPT-4)."
    }
  }
}
