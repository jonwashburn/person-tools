{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.json",
  "title": "A card: the ask's layout (section 27.5)",
  "type": "object",
  "required": [
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "headline"
            ],
            "additionalProperties": false,
            "properties": {
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            }
          },
          {
            "type": "object",
            "required": [
              "facts"
            ],
            "additionalProperties": false,
            "properties": {
              "facts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "when_where"
            ],
            "additionalProperties": false,
            "properties": {
              "when_where": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "when": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "where": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "price"
            ],
            "additionalProperties": false,
            "properties": {
              "price": {
                "type": "object",
                "required": [
                  "amount"
                ],
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^\\d{1,7}(\\.\\d{2})?$"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "media"
            ],
            "additionalProperties": false,
            "properties": {
              "media": {
                "type": "string",
                "pattern": "^(m|om)_[a-z0-9_]{4,60}$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "quote"
            ],
            "additionalProperties": false,
            "properties": {
              "quote": {
                "type": "object",
                "required": [
                  "text",
                  "by"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "contact"
            ],
            "additionalProperties": false,
            "properties": {
              "contact": {
                "type": "string",
                "pattern": "^c[1-4]$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "choices"
            ],
            "additionalProperties": false,
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "description": "Equal to step.choices (ASKS-11; checked by the server, not by this schema)."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "input"
            ],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "object",
                "required": [
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "placeholder": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "description": "A client ignores a block it does not know; a server refuses one (ASKS-11)."
}
