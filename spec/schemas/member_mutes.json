{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "member_mutes.json",
  "title": "The person's mutes: GET /v1/member/mutes (section 26.10)",
  "type": "object",
  "required": [
    "mutes"
  ],
  "additionalProperties": false,
  "properties": {
    "mutes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mute_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "mute_id": {
            "$ref": "common.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "since": {
            "$ref": "common.json#/$defs/time"
          }
        }
      }
    }
  }
}
